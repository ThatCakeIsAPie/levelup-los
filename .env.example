# Copy to .env.local (gitignored) and fill in. See docs/backend.md.
#
# Data source: "local" (browser storage + demo seed, like the GitHub Pages demo)
# or "supabase". When unset, the app uses Supabase if both values below are set.
VITE_DATA_SOURCE=supabase

# Local Supabase (`npm run db:start`): the API URL is http://127.0.0.1:54321 and
# the anon key is the CLI's public development key printed by `npx supabase status`
# (ANON_KEY, or PUBLISHABLE_KEY). For hosted Supabase use the project's URL and
# anon/publishable key from Project Settings -> API. Never put the service role
# key in a VITE_ variable: everything VITE_ ends up in the browser bundle.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-key-from-npx-supabase-status
